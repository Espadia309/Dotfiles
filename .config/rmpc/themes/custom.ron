#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    background_color: "#0d0d14",
    text_color: "#d4909a",
    borders_style: (fg: "#52263e"),
    highlight_border_style: (fg: "#ac3332"),
    highlighted_item_style: (fg: "#0d0d14", bg: "#ac3332", modifiers: "Bold"),
    current_item_style: (fg: "#e8b4b8", bg: "#52263e", modifiers: "Bold"),
    tab_bar: (
        active_style: (fg: "#0d0d14", bg: "#ac3332", modifiers: "Bold"),
        inactive_style: (fg: "#8c5060"),
    ),
    progress_bar: (
        symbols: ["", "█", "", "█", ""],
        track_style: (fg: "#1a1020"),
        elapsed_style: (fg: "#ac3332"),
        thumb_style: (fg: "#ac3332", bg: "#1a1020"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#52263e"),
    ),
    symbols: (
        song: "󰎵 ",
        dir: " ",
        marker: "󰍐 ",
        ellipsis: "...",
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist), default: (kind: Text("Unknown"))),
            width: "20%",
            style: (fg: "#ac3332"),
            label: "Artist",
        ),
        (
            prop: (kind: Property(Title), default: (kind: Text("Unknown"))),
            width: "40%",
            style: (fg: "#d4909a"),
            label: "Title",
        ),
        (
            prop: (kind: Property(Album), default: (kind: Text("Unknown Album"))),
            width: "35%",
            style: (fg: "#8c5060"),
            label: "Album",
        ),
        (
            prop: (kind: Property(Duration), default: (kind: Text("-"))),
            width: "5",
            style: (fg: "#5c3040"),
            alignment: Right,
            label: "Len",
        ),
    ],
    header: (rows: []),
)
